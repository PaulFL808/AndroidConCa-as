<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.asistencia.profesor.ui.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_mainFragment"
            app:destination="@id/mainFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/mainFragment"
        android:name="com.example.asistencia.profesor.ui.MainFragment"
        android:label="Main"
        tools:layout="@layout/fragment_main">
        <action
            android:id="@+id/action_mainFragment_to_createSessionFragment"
            app:destination="@id/createSessionFragment" />
        <action
            android:id="@+id/action_mainFragment_to_activeSessionFragment"
            app:destination="@id/activeSessionFragment" />
        <action
            android:id="@+id/action_mainFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/mainFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/createSessionFragment"
        android:name="com.example.asistencia.profesor.ui.CreateSessionFragment"
        android:label="Create Session"
        tools:layout="@layout/fragment_create_session">
        <action
            android:id="@+id/action_createSessionFragment_to_activeSessionFragment"
            app:destination="@id/activeSessionFragment"
            app:popUpTo="@id/mainFragment" />
    </fragment>

    <fragment
        android:id="@+id/activeSessionFragment"
        android:name="com.example.asistencia.profesor.ui.ActiveSessionFragment"
        android:label="Active Session"
        tools:layout="@layout/fragment_active_session">
        <argument
            android:name="sessionId"
            app:argType="string" />
        <action
            android:id="@+id/action_activeSessionFragment_to_mainFragment"
            app:destination="@id/mainFragment"
            app:popUpTo="@id/mainFragment"
            app:popUpToInclusive="true" />
    </fragment>
</navigation>
